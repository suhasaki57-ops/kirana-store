# ============================================================
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# Set these in Vercel Dashboard -> Project -> Settings -> Environment Variables
# ============================================================

# Your Render backend URL (after deploying backend)
NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api/v1

# Your Vercel frontend URL (after deploying frontend)
NEXT_PUBLIC_FRONTEND_URL=https://your-app.vercel.app

# Razorpay Publishable Key (get from dashboard.razorpay.com)


# Stripe Publishable Key (get from dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_PUBLIC_STRIPE_PUBLISHABLE_KEY
